name: ⚡ Performance Benchmarks

on:
  push:
    branches: [ master ]
  pull_request:
    branches: [ master ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  benchmark:
    name: ⚡ Performance Tests
    runs-on: ${{ matrix.os }}
    timeout-minutes: 120

    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest]
        fpc: [ '3.2.2' ]

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🔧 Setup benchmark toolchain
        shell: bash
        run: |
          sudo apt-get update
          sudo apt-get install -y fpc libssl-dev time
          fpc -iV
          openssl version

      - name: 🏗️ Build benchmark program
        shell: bash
        run: |
          echo "=== Building Performance Benchmark ==="
          mkdir -p tests/bin
          fpc -Fusrc -FEtests/bin tests/test_performance_comparison.pas

      - name: ⚡ Run performance benchmarks
        shell: bash
        run: |
          echo "=== Running full performance benchmark suite ==="

          if [[ ! -x "./tests/bin/test_performance_comparison" ]]; then
            echo "[INFO] Benchmark executable not found, building from source..."
            fpc -Fusrc -FEtests/bin tests/test_performance_comparison.pas
          fi

          ./tests/bin/test_performance_comparison

      - name: 📊 Generate benchmark report
        shell: bash
        run: |
          TIMESTAMP="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
          REPORT="Performance-Report-${{ matrix.os }}.md"

          cat > "$REPORT" <<EOF
          # ⚡ Performance Benchmark Report

          - Generated: ${TIMESTAMP}
          - Platform: ${{ matrix.os }}
          - FPC Version: ${{ matrix.fpc }}
          - Benchmark scope: full checked-in comparison suite

          ## Execution Notes

          - This dormant workflow currently keeps Linux as the only truthful benchmark runner.
          - The benchmark source is compiled directly with \`fpc\` because the checked-in Lazarus project targets Linux only.
          - This dormant Linux benchmark workflow does not expose per-category dispatch inputs until the benchmark binary supports them.
          - Restore Windows or macOS only after those lanes have their own dependency setup and runtime proof.
          EOF

      - name: 📤 Upload benchmark results
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: Performance-Report-${{ matrix.os }}
          path: Performance-Report-*.md
          retention-days: 30

  # ==============================================================================
  # 性能对比分析
  # ==============================================================================
  performance-analysis:
    name: 📊 Performance Analysis
    runs-on: ubuntu-latest
    needs: benchmark
    if: always()

    steps:
      - name: 📥 Download all reports
        uses: actions/download-artifact@37930b1c2abaa49bbe596cd826c3c89aef350131 # v7
        with:
          path: benchmark-reports/

      - name: 📊 Generate comparison report
        shell: bash
        run: |
          echo "## ⚡ fafafa.ssl Performance Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "Benchmarks completed for the currently supported dormant runner set:" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"

          echo "| Platform | Report |" >> "$GITHUB_STEP_SUMMARY"
          echo "|----------|--------|" >> "$GITHUB_STEP_SUMMARY"

          mapfile -t reports < <(find benchmark-reports -name "Performance-Report-*.md" | sort)
          if [[ "${#reports[@]}" -eq 0 ]]; then
            echo "[ERROR] no performance reports were downloaded"
            exit 1
          fi

          for report in "${reports[@]}"; do
            platform="$(basename "$report" .md)"
            platform="${platform#Performance-Report-}"
            echo "| ${platform} | \`$(basename "$report")\` |" >> "$GITHUB_STEP_SUMMARY"
          done

          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "### 📈 Key Findings" >> "$GITHUB_STEP_SUMMARY"
          echo "- Current dormant workflow truth is Linux-only until other runners have real toolchain and runtime proof" >> "$GITHUB_STEP_SUMMARY"
          echo "- The benchmark binary is compiled directly from source instead of a Linux-locked Lazarus project file" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"

          echo "### 🎯 Recommendations" >> "$GITHUB_STEP_SUMMARY"
          echo "- Re-enable Windows or macOS only after those lanes gain dedicated dependency setup and runtime evidence" >> "$GITHUB_STEP_SUMMARY"
          echo "- Keep using Linux as the truthful benchmark baseline for dormant static review" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
