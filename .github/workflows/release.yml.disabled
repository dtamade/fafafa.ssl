name: Release v1.5.0

on:
  push:
    tags:
      - 'v1.5.0'
  workflow_dispatch:
    inputs:
      version:
        description: Existing release tag to publish
        required: true
        default: v1.5.0
        type: string

permissions:
  contents: write

jobs:
  release:
    name: Validate and publish v1.5.0
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Resolve release version
        id: version
        shell: bash
        run: |
          if [[ "${{ github.event_name }}" == "workflow_dispatch" ]]; then
            VERSION="${{ github.event.inputs.version }}"
          else
            VERSION="${GITHUB_REF_NAME}"
          fi

          if [[ "$VERSION" != "v1.5.0" ]]; then
            echo "[ERROR] This release workflow is pinned to v1.5.0; got: $VERSION"
            exit 1
          fi

          if ! git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null; then
            echo "[ERROR] Tag $VERSION must already exist before this workflow can publish a release."
            echo "[ERROR] Do not let the release workflow create the tag implicitly."
            exit 1
          fi

          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
          echo "VERSION=$VERSION" >> "$GITHUB_ENV"
          echo "[INFO] release version: $VERSION"

      - name: Install dependencies
        shell: bash
        run: |
          sudo apt-get update
          sudo apt-get install -y fpc libssl-dev libwolfssl-dev libmbedtls-dev python3
          fpc -iV
          openssl version

      - name: Verify version metadata
        shell: bash
        run: |
          grep -F "FAFAFA_SSL_VERSION_STRING = '1.5.0'" src/fafafa.ssl.base.pas
          grep -F "FAFAFA_SSL_INTERFACE_VERSION = 10500" src/fafafa.ssl.base.pas
          grep -F '<Version Major="1" Minor="5" Release="0" Build="0"/>' fafafa_ssl.lpk
          grep -F "Version-v1.5.0" README.md
          grep -F "releases/tag/v1.5.0" README.md
          grep -F "## 最新版本 v1.5.0" README.md
          grep -F "## [1.5.0] - 2026-05-12" CHANGELOG.md
          grep -F "FAFAFA_SSL_INTERFACE_VERSION = 10500" RELEASE_NOTES_V1.5.0.md
          grep -F "TSSLFactory.*" RELEASE_NOTES_V1.5.0.md

      - name: Run release gates
        shell: bash
        run: |
          RUN_ID="release_1_5_0_${GITHUB_RUN_ID:-0}_${GITHUB_RUN_ATTEMPT:-0}"
          mkdir -p tmp/test-reports

          python3 scripts/compile_all_modules.py
          bash scripts/run_minimal_ci_gate.sh --fast-local
          bash scripts/run_freepascal_tls13_completeness_gate.sh --fast-local --run-id "$RUN_ID"
          python3 scripts/check_code_style.py src
          bash scripts/run_phase2_performance_baseline.sh --dry-run --fast-local
          bash tests/scripts/test_release_workflow_v1_5_0_contract.sh

      - name: Create source archive
        shell: bash
        run: |
          VERSION="${{ steps.version.outputs.version }}"
          ARCHIVE_NAME="fafafa-ssl-${VERSION}-source"

          tar -czf "${ARCHIVE_NAME}.tar.gz" \
            --exclude='./.git' \
            --exclude='./.github' \
            --exclude='./.ace-tool' \
            --exclude='./.agents' \
            --exclude='./.codex' \
            --exclude='./.fusion' \
            --exclude='./bin' \
            --exclude='./tmp' \
            --exclude='./test-reports' \
            --exclude='./tests/bin' \
            --exclude='./tests/lib' \
            --exclude='./examples/bin' \
            --exclude='./artifacts' \
            --exclude='./target' \
            --exclude='./examples/digital_signature/private.pem' \
            --exclude='./examples/digital_signature/public.pem' \
            --exclude='*.o' \
            --exclude='*.ppu' \
            --exclude='*.a' \
            --exclude='*.so' \
            --exclude='*.dll' \
            --exclude='*.dylib' \
            --exclude='*.exe' \
            --exclude='*.compiled' \
            --exclude='*.res' \
            .

          ls -lh "${ARCHIVE_NAME}.tar.gz"
          echo "archive=${ARCHIVE_NAME}.tar.gz" >> "$GITHUB_ENV"

      - name: Upload release archive evidence
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: release-v1.5.0-source-archive
          path: fafafa-ssl-v1.5.0-source.tar.gz
          if-no-files-found: error
          retention-days: 30

      - name: Publish GitHub Release
        uses: softprops/action-gh-release@b4309332981a82ec1c5618f44dd2e27cc8bfbfda # v3
        with:
          tag_name: ${{ steps.version.outputs.version }}
          name: fafafa.ssl ${{ steps.version.outputs.version }}
          body_path: RELEASE_NOTES_V1.5.0.md
          draft: false
          prerelease: false
          files: |
            fafafa-ssl-v1.5.0-source.tar.gz
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Summary
        shell: bash
        run: |
          echo "## Release v1.5.0" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "- version: \`${{ steps.version.outputs.version }}\`" >> "$GITHUB_STEP_SUMMARY"
          echo "- body: \`RELEASE_NOTES_V1.5.0.md\`" >> "$GITHUB_STEP_SUMMARY"
          echo "- archive: \`fafafa-ssl-v1.5.0-source.tar.gz\`" >> "$GITHUB_STEP_SUMMARY"
