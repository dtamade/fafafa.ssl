name: WinSSL Runtime Gate

on:
  push:
    branches: [ master, main, develop ]
    paths:
      - 'src/fafafa.ssl.winssl*.pas'
      - 'src/fafafa.ssl.base.pas'
      - 'src/fafafa.ssl.connection.base.pas'
      - 'src/fafafa.ssl.factory.pas'
      - 'src/fafafa.ssl.context.config.pas'
      - 'src/fafafa.ssl.asn1.pas'
      - 'src/fafafa.ssl.x509.pas'
      - 'src/fafafa.ssl.pas'
      - 'src/fafafa.ssl.context.builder.pas'
      - 'examples/*winssl*.pas'
      - 'tests/winssl/**'
      - 'tests/quick_winssl_validation.ps1'
      - 'tests/run_winssl_tests.ps1'
      - 'scripts/run_wave_b_windows_gate.ps1'
      - '.github/workflows/winssl-tests.yml'
      - '.github/workflows/winssl-tests.yml.disabled'
  pull_request:
    branches: [ master, main, develop ]
    paths:
      - 'src/fafafa.ssl.winssl*.pas'
      - 'src/fafafa.ssl.base.pas'
      - 'src/fafafa.ssl.connection.base.pas'
      - 'src/fafafa.ssl.factory.pas'
      - 'src/fafafa.ssl.context.config.pas'
      - 'src/fafafa.ssl.asn1.pas'
      - 'src/fafafa.ssl.x509.pas'
      - 'src/fafafa.ssl.pas'
      - 'src/fafafa.ssl.context.builder.pas'
      - 'examples/*winssl*.pas'
      - 'tests/winssl/**'
      - 'tests/quick_winssl_validation.ps1'
      - 'tests/run_winssl_tests.ps1'
      - 'scripts/run_wave_b_windows_gate.ps1'
      - '.github/workflows/winssl-tests.yml'
      - '.github/workflows/winssl-tests.yml.disabled'
  workflow_dispatch:
    inputs:
      winssl_session_host:
        description: Optional host override for WinSSL session resumption runtime probe (e.g. www.google.com)
        required: false
        default: ""
      winssl_enable_native_probe:
        description: Optional opt-in WinSSL native probe for Schannel session evidence (may fail the broader runtime suite)
        required: false
        default: "false"

permissions:
  contents: read

jobs:
  winssl-runtime-gate:
    name: WinSSL Runtime Gate
    runs-on: windows-latest
    timeout-minutes: 90

    steps:
      - name: Checkout
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: Resolve run id
        shell: powershell
        run: |
          $runId = "gh_${{ github.run_id }}_${{ github.run_attempt }}"
          Add-Content -Path $env:GITHUB_ENV -Value "WINSSL_RUN_ID=$runId"
          Write-Host ("[INFO] WINSSL_RUN_ID=" + $runId)

      - name: Install dependencies
        shell: powershell
        run: |
          choco install -y freepascal lazarus
          $fpcCandidates = @(
            "C:\tools\freepascal\bin\x86_64-win64",
            "C:\tools\freepascal\bin\i386-win32",
            "C:\tools\freepascal\bin"
          ) | Where-Object { Test-Path $_ }
          if (-not $fpcCandidates) {
            Write-Host "[ERROR] no FreePascal candidate path found after installation" -ForegroundColor Red
            exit 1
          }
          $fpcPreferredDir = $fpcCandidates | Select-Object -First 1
          $env:PATH = "$fpcPreferredDir;$env:PATH"
          $fpcPreferredDir | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
          Write-Host ("[INFO] Preferred FPC path: " + $fpcPreferredDir)
          $fpcCommand = Get-Command fpc -ErrorAction SilentlyContinue
          if (-not $fpcCommand) {
            Write-Host "[ERROR] fpc not found in PATH after installation" -ForegroundColor Red
            exit 1
          }
          Write-Host ("[INFO] fpc resolved to: " + $fpcCommand.Source)
          & $fpcCommand.Source -iV

          $lazarusCandidates = @(
            "C:\lazarus",
            "C:\Program Files\Lazarus",
            "C:\tools\lazarus"
          )
          foreach ($p in $lazarusCandidates) {
            if (Test-Path $p) {
              $env:PATH = "$p;$env:PATH"
              $p | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
              Write-Host ("[INFO] Added to PATH: " + $p)
            }
          }
          if (-not (Get-Command lazbuild -ErrorAction SilentlyContinue)) {
            Write-Host "[ERROR] lazbuild not found in PATH after Lazarus installation" -ForegroundColor Red
            exit 1
          }
          lazbuild --version

          choco install -y openssl
          $opensslCandidates = @(
            "C:\Program Files\OpenSSL-Win64\bin",
            "C:\Program Files\OpenSSL\bin",
            "C:\tools\openssl\bin"
          )
          $foundOpenSSL = $false
          foreach ($p in $opensslCandidates) {
            if (Test-Path $p) {
              $foundOpenSSL = $true
              $env:PATH = "$p;$env:PATH"
              $p | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
              Write-Host ("[INFO] Added to PATH: " + $p)
            }
          }
          if (-not (Get-Command openssl -ErrorAction SilentlyContinue)) {
            Write-Host "[ERROR] openssl not found in PATH after installation" -ForegroundColor Red
            if (-not $foundOpenSSL) {
              Write-Host "[INFO] Checked paths:" -ForegroundColor Yellow
              $opensslCandidates | ForEach-Object { Write-Host ("  - " + $_) -ForegroundColor Yellow }
            }
            exit 1
          }
          openssl version

      - name: Check Windows version
        shell: powershell
        run: |
          Write-Host "=== Windows Environment Info ===" -ForegroundColor Green
          Write-Host "OS: $((Get-CimInstance Win32_OperatingSystem).Caption)" -ForegroundColor Yellow
          Write-Host "Version: $((Get-CimInstance Win32_OperatingSystem).Version)" -ForegroundColor Yellow
          Write-Host "Architecture: $env:PROCESSOR_ARCHITECTURE" -ForegroundColor Yellow
          Write-Host "Schannel available: $(Test-Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL')" -ForegroundColor Yellow

      - name: Run quick WinSSL smoke
        id: quick_smoke
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path test-reports | Out-Null
          $quickLog = "test-reports/winssl_quick_smoke_${{ env.WINSSL_RUN_ID }}.log"
          $quickOutput = @()
          pwsh -NoProfile -ExecutionPolicy Bypass -File tests/quick_winssl_validation.ps1 *>&1 | Tee-Object -Variable quickOutput
          $quickExitCode = $LASTEXITCODE
          @($quickOutput) | Out-File -FilePath $quickLog -Encoding utf8
          if ($quickExitCode -ne 0) {
            exit $quickExitCode
          }

      - name: Run Windows Wave B gate
        id: wave_b_gate
        shell: powershell
        run: |
          pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/run_wave_b_windows_gate.ps1 -RunId "${{ env.WINSSL_RUN_ID }}" -OutputDir test-reports

      - name: Run broader WinSSL runtime suite
        id: runtime_suite
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path test-reports | Out-Null
          $runtimeLog = "test-reports/winssl_runtime_suite_${{ env.WINSSL_RUN_ID }}.log"
          $runtimeOutput = @()
          $sessionHost = "${{ github.event.inputs.winssl_session_host }}"
          $nativeProbeInput = "${{ github.event.inputs.winssl_enable_native_probe }}"
          if (-not [string]::IsNullOrWhiteSpace($sessionHost)) {
            $env:FAFAFA_WINSSL_SESSION_HOST = $sessionHost
            Write-Host ("[INFO] Using WinSSL session resumption host override: " + $sessionHost)
          } else {
            Write-Host "[INFO] Using default WinSSL session resumption host from test program"
          }
          if ($nativeProbeInput -match '^(?i:true|1|yes|on)$') {
            $env:FAFAFA_WINSSL_ENABLE_NATIVE_PROBE = "1"
            Write-Host "[INFO] Enabling risky WinSSL native probe for Schannel session evidence"
          } else {
            Write-Host "[INFO] Keeping WinSSL native probe disabled by default"
          }
          pwsh -NoProfile -ExecutionPolicy Bypass -File tests/run_winssl_tests.ps1 *>&1 | Tee-Object -Variable runtimeOutput
          $runtimeExitCode = $LASTEXITCODE
          @($runtimeOutput) | Out-File -FilePath $runtimeLog -Encoding utf8
          if ($runtimeExitCode -ne 0) {
            exit $runtimeExitCode
          }

      - name: Generate WinSSL workflow summary
        if: always()
        shell: powershell
        run: |
          $summary = @"
          ## WinSSL Runtime Gate

          - Date: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
          - Platform: Windows $([System.Environment]::OSVersion.Version)
          - Workflow file: .github/workflows/winssl-tests.yml.disabled
          - run_id: ${{ env.WINSSL_RUN_ID }}

          | Lane | Outcome | Evidence |
          |------|---------|----------|
          | Quick smoke | ${{ steps.quick_smoke.outcome }} | test-reports/winssl_quick_smoke_${{ env.WINSSL_RUN_ID }}.log |
          | Windows Wave B gate | ${{ steps.wave_b_gate.outcome }} | test-reports/wave_b_windows_gate_summary_${{ env.WINSSL_RUN_ID }}.md |
          | Broader runtime suite | ${{ steps.runtime_suite.outcome }} | test-reports/winssl_runtime_suite_${{ env.WINSSL_RUN_ID }}.log |

          This workflow records the observed results of the repository WinSSL scripts for the current run only.
          Review the uploaded runtime logs before making backend readiness or production support claims.
          For host overrides or risky native probe collection, use wave-b-b2-manual.yml.
          "@
          $summary | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append

      - name: Upload WinSSL evidence
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: winssl-windows-evidence-${{ env.WINSSL_RUN_ID }}
          path: |
            test-reports/winssl_quick_smoke_${{ env.WINSSL_RUN_ID }}.log
            test-reports/wave_b_windows_gate_summary_${{ env.WINSSL_RUN_ID }}.md
            test-reports/wave_b_windows_*.log
            test-reports/validate_all_modules_report_${{ env.WINSSL_RUN_ID }}.md
            test-reports/validate_all_modules_compile_${{ env.WINSSL_RUN_ID }}.log
            test-reports/winssl_runtime_suite_${{ env.WINSSL_RUN_ID }}.log
          if-no-files-found: warn
