name: 🏃‍♂️ WinSSL Detailed Tests

on:
  push:
    branches: [ master, develop ]
  pull_request:
    branches: [ master, develop ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  winssl-integration:
    name: 🪟 WinSSL Integration Tests
    runs-on: windows-latest
    timeout-minutes: 90

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🚀 Setup FPC and Lazarus
        shell: powershell
        run: |
          choco install -y freepascal lazarus

          $fpcCandidates = @(
            "C:\tools\freepascal\bin\x86_64-win64",
            "C:\tools\freepascal\bin\i386-win32",
            "C:\tools\freepascal\bin"
          ) | Where-Object { Test-Path $_ }
          if (-not $fpcCandidates) {
            Write-Host "[ERROR] no FreePascal candidate path found after installation" -ForegroundColor Red
            exit 1
          }
          $fpcPreferredDir = $fpcCandidates | Select-Object -First 1
          $env:PATH = "$fpcPreferredDir;$env:PATH"
          $fpcPreferredDir | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
          Write-Host ("[INFO] Preferred FPC path: " + $fpcPreferredDir)
          $fpcCommand = Get-Command fpc -ErrorAction SilentlyContinue
          if (-not $fpcCommand) {
            Write-Host "[ERROR] fpc not found in PATH after installation" -ForegroundColor Red
            exit 1
          }
          Write-Host ("[INFO] fpc resolved to: " + $fpcCommand.Source)
          Write-Host ("[INFO] system fpc: " + (& $fpcCommand.Source -iV))

          $lazarusCandidates = @(
            "C:\lazarus",
            "C:\Program Files\Lazarus",
            "C:\tools\lazarus"
          )
          foreach ($p in $lazarusCandidates) {
            if (Test-Path $p) {
              $env:PATH = "$p;$env:PATH"
              $p | Out-File -FilePath $env:GITHUB_PATH -Encoding utf8 -Append
              Write-Host ("[INFO] Added to PATH: " + $p)
            }
          }
          if (-not (Get-Command lazbuild -ErrorAction SilentlyContinue)) {
            Write-Host "[ERROR] lazbuild not found in PATH after Lazarus installation" -ForegroundColor Red
            exit 1
          }
          Write-Host ("[INFO] system lazbuild: " + (& lazbuild --version | Select-Object -First 1))

      - name: 📦 Cache Lazarus state
        uses: actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae # v5
        with:
          path: |
            ~/.lazarus
            ~/.fpcpkg
          key: ${{ runner.os }}-lazarus-${{ hashFiles('**/*.lpi') }}
          restore-keys: |
            ${{ runner.os }}-lazarus-

      - name: 🔍 Check Windows version
        shell: powershell
        run: |
          Write-Host "=== Windows Environment Info ===" -ForegroundColor Green
          Write-Host "OS: $((Get-CimInstance Win32_OperatingSystem).Caption)" -ForegroundColor Yellow
          Write-Host "Version: $((Get-CimInstance Win32_OperatingSystem).Version)" -ForegroundColor Yellow
          Write-Host "Architecture: $env:PROCESSOR_ARCHITECTURE" -ForegroundColor Yellow
          Write-Host "Schannel available: $(Test-Path 'HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL')" -ForegroundColor Yellow

      - name: 🧪 Run quick WinSSL smoke
        id: quick_smoke
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path test-reports | Out-Null
          $quickLog = "test-reports/winssl_quick_smoke_${{ github.run_id }}.log"
          pwsh -NoProfile -ExecutionPolicy Bypass -File tests/quick_winssl_validation.ps1 *>&1 | Tee-Object -FilePath $quickLog
          if ($LASTEXITCODE -ne 0) {
            exit $LASTEXITCODE
          }

      - name: 🧪 Run broader WinSSL runtime suite
        id: runtime_suite
        shell: powershell
        run: |
          New-Item -ItemType Directory -Force -Path test-reports | Out-Null
          $runtimeLog = "test-reports/winssl_runtime_suite_${{ github.run_id }}.log"
          $exitCode = 0
          Start-Transcript -Path $runtimeLog
          try {
            pwsh -NoProfile -ExecutionPolicy Bypass -File tests/run_winssl_tests.ps1
            $exitCode = $LASTEXITCODE
          } finally {
            Stop-Transcript
          }
          if ($exitCode -ne 0) {
            exit $exitCode
          }

      - name: 📊 Generate WinSSL workflow summary
        if: always()
        shell: powershell
        run: |
          $summary = @"
          ## 🪟 WinSSL Workflow Report

          - Date: $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')
          - Platform: Windows $([System.Environment]::OSVersion.Version)
          - Workflow file: .github/workflows/winssl-tests.yml.disabled

          | Lane | Outcome | Evidence |
          |------|---------|----------|
          | Quick smoke | ${{ steps.quick_smoke.outcome }} | test-reports/winssl_quick_smoke_${{ github.run_id }}.log |
          | Broader runtime suite | ${{ steps.runtime_suite.outcome }} | test-reports/winssl_runtime_suite_${{ github.run_id }}.log |

          This template records the observed results of the repository WinSSL scripts for the current run only.
          Review the uploaded transcripts before making backend readiness or production support claims.
          "@
          $summary | Out-File -FilePath $env:GITHUB_STEP_SUMMARY -Encoding utf8 -Append

      - name: 📤 Upload WinSSL evidence
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: winssl-windows-evidence-${{ github.run_id }}
          path: |
            test-reports/winssl_quick_smoke_${{ github.run_id }}.log
            test-reports/winssl_runtime_suite_${{ github.run_id }}.log
          if-no-files-found: warn
