name: 🔍 Code Quality Check

on:
  push:
    branches: [ master, develop ]
  pull_request:
    branches: [ master, develop ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # ==============================================================================
  # 代码风格检查
  # ==============================================================================
  code-style:
    name: 🎨 Code Style
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🔧 Setup Python
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405 # v6
        with:
          python-version: '3.10'
          cache: 'pip'

      - name: 📦 Install dependencies
        run: |
          pip install --upgrade pip
          pip install -r scripts/requirements.txt || pip install pyyaml

      - name: 🔍 Run code style check
        run: |
          echo "=== Checking code style ==="
          python3 scripts/check_code_style.py src
        continue-on-error: false

      - name: 📊 Upload style report
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: Code-Style-Report
          path: |
            code_style_report.txt
            code_style_details.json

  # ==============================================================================
  # 文档完整性检查
  # ==============================================================================
  docs-check:
    name: 📚 Documentation
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 📋 Check required documents
        run: |
          echo "=== Checking required documentation ==="
          REQUIRED_DOCS=(
            "README.md"
            "CLAUDE.md"
            "CURRENT_STATUS.md"
            "docs/ARCHITECTURE.md"
          )

          MISSING=()
          for doc in "${REQUIRED_DOCS[@]}"; do
            if [[ ! -f "$doc" ]]; then
              MISSING+=("$doc")
              echo "❌ Missing: $doc"
            else
              echo "✅ Found: $doc"
            fi
          done

          if [[ ${#MISSING[@]} -gt 0 ]]; then
            echo "::error::Missing documentation files: ${MISSING[*]}"
            exit 1
          fi

      - name: 📝 Check documentation consistency
        run: |
          echo "=== Checking documentation consistency ==="

          # 检查 README 和 CLAUDE 的测试覆盖率声明
          README_COVERAGE=$(grep -o '[0-9]*\.[0-9]*%' README.md | head -1 || echo "unknown")
          CLAUDE_COVERAGE=$(grep -o '[0-9]*\.[0-9]*%' CLAUDE.md | head -1 || echo "unknown")

          echo "README coverage: $README_COVERAGE"
          echo "CLAUDE coverage: $CLAUDE_COVERAGE"

          # 检查是否一致
          if [[ "$README_COVERAGE" != "$CLAUDE_COVERAGE" ]]; then
            echo "⚠️  Warning: Coverage percentages differ between README and CLAUDE"
          fi

  # ==============================================================================
  # 编译检查
  # ==============================================================================
  build-check:
    name: 🏗️ Build Verification (System Toolchain)
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🔧 Setup FPC and Lazarus
        run: |
          sudo apt-get update
          sudo apt-get install -y fpc lazarus
          echo "[INFO] system fpc: $(fpc -iV)"
          echo "[INFO] system lazbuild: $(lazbuild --version | head -n 1)"

      - name: 📦 Install OpenSSL build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y libssl-dev pkg-config

      - name: 🏗️ Build core library
        run: |
          echo "=== Building fafafa.ssl library ==="
          lazbuild src/fafafa.ssl.lpk

      - name: 🏗️ Build sample applications
        run: |
          echo "=== Building sample applications ==="
          find examples/ -name "*.lpi" -exec lazbuild {} \; || echo "Some examples failed to build (acceptable)"

  # ==============================================================================
  # 模块完整性检查
  # ==============================================================================
  module-integrity:
    name: 🔌 Module Integrity
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🔍 Check module declarations
        run: |
          echo "=== Checking module declarations ==="

          # 检查所有 API 模块是否都声明了 exports
          MISSING_EXPORTS=()
          for api_file in src/fafafa.ssl.openssl.api.*.pas; do
            if [[ -f "$api_file" ]]; then
              if ! grep -q "initialization" "$api_file"; then
                MISSING_EXPORTS+=("$api_file")
              fi
            fi
          done

          if [[ ${#MISSING_EXPORTS[@]} -gt 0 ]]; then
            echo "⚠️  Warning: Modules without initialization blocks:"
            for m in "${MISSING_EXPORTS[@]}"; do
              echo "  - $m"
            done
          fi

      - name: 📊 Check interface consistency
        run: |
          echo "=== Checking interface consistency ==="

          # 检查 WinSSL 模块是否实现了所有必需接口
          WINSSL_MODULES=(
            "src/fafafa.ssl.winssl.lib"
            "src/fafafa.ssl.winssl.context"
            "src/fafafa.ssl.winssl.connection"
            "src/fafafa.ssl.winssl.certificate"
          )

          for module in "${WINSSL_MODULES[@]}"; do
            if [[ ! -f "$module.pas" ]]; then
              echo "❌ Missing WinSSL module: $module.pas"
            else
              echo "✅ Found WinSSL module: $module.pas"
            fi
          done

  # ==============================================================================
  # 安全检查
  # ==============================================================================
  security-check:
    name: 🔒 Security Check
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 🔍 Check for TODO/FIXME in production code
        run: |
          echo "=== Checking for TODO/FIXME ==="
          TODO_COUNT=$(grep -r "TODO\|FIXME" src/ --include="*.pas" | wc -l)
          echo "Found $TODO_COUNT TODO/FIXME comments"

          if [[ $TODO_COUNT -gt 100 ]]; then
            echo "::warning::High number of TODO/FIXME comments: $TODO_COUNT"
          fi

          # 显示前 10 个 TODO/FIXME
          grep -r "TODO\|FIXME" src/ --include="*.pas" | head -10

      - name: 🔐 Check for hardcoded secrets
        run: |
          echo "=== Checking for potential hardcoded secrets ==="

          # 检查常见的密钥/密码模式
          if grep -ri "password\s*=\s*['\"][^'\"]*['\"]" src/ --include="*.pas"; then
            echo "::warning::Potential hardcoded password found"
          fi

          if grep -ri "private\s*key\s*=\s*['\"][^'\"]*['\"]" src/ --include="*.pas"; then
            echo "::warning::Potential hardcoded private key found"
          fi

  # ==============================================================================
  # 生成质量报告
  # ==============================================================================
  quality-report:
    name: 📊 Quality Report
    runs-on: ubuntu-latest
    needs: [code-style, docs-check, build-check, module-integrity, security-check]
    if: always()

    steps:
      - name: 📥 Checkout code
        uses: actions/checkout@93cb6efe18208431cddfb8368fd83d5badbf9bfd # v5
        with:
          persist-credentials: false

      - name: 📊 Generate quality report
        run: |
          echo "## 🔍 fafafa.ssl Code Quality Report" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Generated on: $(date)" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          echo "### ✅ Workflow Results" >> $GITHUB_STEP_SUMMARY
          echo "| Job | Result |" >> $GITHUB_STEP_SUMMARY
          echo "|-----|--------|" >> $GITHUB_STEP_SUMMARY
          echo "| Code Style | ${{ needs.code-style.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Documentation | ${{ needs.docs-check.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Build Verification | ${{ needs.build-check.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Module Integrity | ${{ needs.module-integrity.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "| Security Check | ${{ needs.security-check.result }} |" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          echo "### 📌 Toolchain Truth" >> $GITHUB_STEP_SUMMARY
          echo "- Build verification uses the runner system toolchain installed in this workflow." >> $GITHUB_STEP_SUMMARY
          echo "- Review individual job logs and uploaded artifacts for concrete findings." >> $GITHUB_STEP_SUMMARY
          echo "- This dormant template does not assert fixed coverage percentages, backend completeness, or a release grade." >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
